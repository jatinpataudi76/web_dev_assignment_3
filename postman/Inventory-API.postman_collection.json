{
  "info": {
    "_postman_id": "d8c2c3b4-3b7a-4d9a-9c1e-7f6a5b4c3d2e",
    "name": "Inventory Management API - Web Dev III Assignment 3",
    "description": "Postman collection for the Inventory and Data Management System. Start MongoDB and the server on http://localhost:5000 first. Run the requests from top to bottom. The Create Product request saves the new product ID in the productId collection variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "productId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Create Product",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "if (pm.response.code === 201 && data._id) {",
              "    pm.collectionVariables.set('productId', data._id);",
              "}",
              "pm.test('Status is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('stockValue equals price x quantity', function () {",
              "    pm.expect(data.stockValue).to.eql(data.price * data.quantity);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Wireless Mouse\",\"sku\":\"ELEC-MS-450\",\"category\":\"Electronics\",\"price\":899,\"quantity\":30,\"reorderLevel\":10,\"supplier\":\"Logitech India\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        },
        "description": "Creates a product and returns 201. The new product's _id is stored in the productId variable for the later requests. If you run this request again, change the SKU, otherwise you will get a 409 duplicate SKU error."
      },
      "response": []
    },
    {
      "name": "2. Get All Products",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "pm.test('Status is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Pagination fields are present', function () {",
              "    pm.expect(data).to.have.property('total');",
              "    pm.expect(data).to.have.property('page');",
              "    pm.expect(data).to.have.property('totalPages');",
              "    pm.expect(data).to.have.property('count');",
              "    pm.expect(data.products).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        },
        "description": "Returns 10 products by default with total, page, totalPages and count. With the seeded database, total is 12 and totalPages is 2."
      },
      "response": []
    },
    {
      "name": "3. Filter by Category",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const data = pm.response.json();",
              "pm.test('All products are in Furniture', function () {",
              "    data.products.forEach(function (product) {",
              "        pm.expect(product.category).to.eql('Furniture');",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products?category=Furniture",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ],
          "query": [
            {
              "key": "category",
              "value": "Furniture"
            }
          ]
        },
        "description": "Case-insensitive category filter. Returns Study Table and Ergonomic Office Chair with the seeded data."
      },
      "response": []
    },

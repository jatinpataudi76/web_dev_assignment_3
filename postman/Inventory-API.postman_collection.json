        "description": "Searches both name and SKU. Try search=ELEC-HP to search by SKU."
      },
      "response": []
    },
    {
      "name": "5. Sort by Price Descending",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const data = pm.response.json();",
              "pm.test('Prices are descending', function () {",
              "    pm.expect(data.products[0].price).to.be.at.least(data.products[1].price);",
              "    pm.expect(data.products[1].price).to.be.at.least(data.products[2].price);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products?sort=price&order=desc&limit=3",
          "host": [
